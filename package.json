{
  "name": "komori-launcher",
  "productName": "Komori Launcher",
  "version": "0.5.0",
  "description": "Komori Launcher — лаунчер Minecraft сервера Komori",
  "main": "src/main/main.js",
  "author": "Komori",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dev": "electron-builder --win nsis --publish never -c.extraMetadata.komoriDev=true -c.productName=\"Komori Launcher DEV\" -c.appId=fun.komori.launcher.dev -c.nsis.artifactName=\"Komori-Launcher-DEV-Setup-${version}.${ext}\"",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fun.komori.launcher",
    "productName": "Komori Launcher",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "build/icon.ico", "komori.config.json", "package.json"],
    "publish": [{ "provider": "github", "owner": "k1opy", "repo": "komori-launcher", "releaseType": "release" }],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Komori-Launcher-Setup-${version}.${ext}",
      "shortcutName": "Komori Launcher"
    }
  }
}
